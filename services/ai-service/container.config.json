{
  "$schema": "https://developers.weixin.qq.com/miniprogram/dev/wxcloudrun/src/guide/settings/container-config.html",
  "containerPort": 80,
  "dockerfilePath": "Dockerfile",
  "buildDir": "",
  "minNum": 0,
  "maxNum": 3,
  "cpu": 0.5,
  "mem": 1,
  "policyType": "cpu",
  "policyThreshold": 60,
  "envParams": {
    "NODE_ENV": "production",
    "LLM_PROVIDER": "${LLM_PROVIDER}",
    "LLM_API_KEY": "${LLM_API_KEY}",
    "LLM_API_ENDPOINT": "${LLM_API_ENDPOINT}",
    "LLM_MODEL": "${LLM_MODEL}"
  },
  "customLogs": {
    "enabled": true,
    "logPath": "/app/logs"
  },
  "initialDelaySeconds": 15
}

