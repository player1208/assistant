{
  "$schema": "https://developers.weixin.qq.com/miniprogram/dev/wxcloudrun/src/guide/settings/container-config.html",
  "containerPort": 80,
  "dockerfilePath": "Dockerfile",
  "buildDir": "",
  "minNum": 0,
  "maxNum": 3,
  "cpu": 0.25,
  "mem": 0.5,
  "policyType": "cpu",
  "policyThreshold": 60,
  "envParams": {},
  "customLogs": {
    "enabled": true,
    "logPath": "/var/log/nginx"
  },
  "initialDelaySeconds": 5
}

